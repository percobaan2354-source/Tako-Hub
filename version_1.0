-- BUILDER GLOBAL
_G.TakoMakeSection = function(text)
    local l = Instance.new("TextLabel", scroll)
    l.Size = UDim2.new(1, 0, 0, 14)
    l.BackgroundTransparency = 1
    l.Text = "• "..text
    l.TextColor3 = Color3.fromRGB(120, 170, 255)
    l.TextSize = 9
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = Enum.TextXAlignment.Left
end

_G.TakoMakeBtn = function(text, color, cbk)
    local b = Instance.new("TextButton", scroll)
    b.Size = UDim2.new(1, 0, 0, 26)
    b.BackgroundColor3 = color or Color3.fromRGB(45, 45, 55)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 9
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    b.MouseButton1Click:Connect(function()
        local o = b.BackgroundColor3
        b.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
        task.wait(0.1)
        b.BackgroundColor3 = o
        if cbk then cbk() end
    end)
end

_G.TakoMakeToggle = function(text, cbk)
    local f = Instance.new("Frame", scroll)
    f.Size = UDim2.new(1, 0, 0, 26)
    f.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    f.BorderSizePixel = 0
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 4)
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(1, -50, 1, 0)
    l.Position = UDim2.new(0, 8, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(230, 230, 230)
    l.TextSize = 9
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = Enum.TextXAlignment.Left
    local bg = Instance.new("Frame", f)
    bg.Size = UDim2.new(0, 30, 0, 14)
    bg.Position = UDim2.new(1, -38, 0.5, -7)
    bg.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
    local kn = Instance.new("Frame", bg)
    kn.Size = UDim2.new(0, 10, 0, 10)
    kn.Position = UDim2.new(0, 2, 0.5, -5)
    kn.BackgroundColor3 = Color3.new(1, 1, 1)
    kn.BorderSizePixel = 0
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)
    local state = false
    local cl = Instance.new("TextButton", f)
    cl.Size = UDim2.new(1, 0, 1, 0)
    cl.BackgroundTransparency = 1
    cl.Text = ""
    cl.MouseButton1Click:Connect(function()
        state = not state
        if state then
            bg.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
            kn.Position = UDim2.new(1, -12, 0.5, -5)
        else
            bg.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
            kn.Position = UDim2.new(0, 2, 0.5, -5)
        end
        if cbk then cbk(state) end
    end)
end

_G.TakoMakeSlider = function(text, min, max, default, cbk)
    local f = Instance.new("Frame", scroll)
    f.Size = UDim2.new(1, 0, 0, 28)
    f.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    f.BorderSizePixel = 0
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 4)
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(1, -12, 0, 10)
    l.Position = UDim2.new(0, 6, 0, 1)
    l.BackgroundTransparency = 1
    l.Text = text..": "..default
    l.TextColor3 = Color3.fromRGB(230, 230, 230)
    l.TextSize = 8
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = Enum.TextXAlignment.Left
    local tr = Instance.new("Frame", f)
    tr.Size = UDim2.new(1, -12, 0, 5)
    tr.Position = UDim2.new(0, 6, 0, 18)
    tr.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
    tr.BorderSizePixel = 0
    Instance.new("UICorner", tr).CornerRadius = UDim.new(1, 0)
    local fl = Instance.new("Frame", tr)
    fl.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
    fl.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
    fl.BorderSizePixel = 0
    Instance.new("UICorner", fl).CornerRadius = UDim.new(1, 0)
    local cl = Instance.new("TextButton", f)
    cl.Size = UDim2.new(1, 0, 1, 0)
    cl.BackgroundTransparency = 1
    cl.Text = ""
    local dg = false
    local function ud(i)
        local ax = tr.AbsolutePosition.X
        local sx = tr.AbsoluteSize.X
        local x = math.clamp(i.Position.X - ax, 0, sx)
        local pc = x / sx
        local v = math.floor((min + (max-min) * pc) * 100) / 100
        fl.Size = UDim2.new(pc, 0, 1, 0)
        l.Text = text..": "..v
        if cbk then cbk(v) end
    end
    cl.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dg = true ud(i) end
    end)
    cl.InputChanged:Connect(function(i)
        if dg and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then ud(i) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dg = false end
    end)
end

