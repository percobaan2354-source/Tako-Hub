local function mSl(t,mn,mx,dv,cbk)
local f=Instance.new("Frame",sc)
f.Size=UDim2.new(1,0,0,30)
f.BackgroundColor3=Color3.fromRGB(45,45,55)
f.BorderSizePixel=0
f.LayoutOrder=n()
Instance.new("UICorner",f).CornerRadius=UDim.new(0,4)
local l=Instance.new("TextLabel",f)
l.Size=UDim2.new(1,-12,0,11)
l.Position=UDim2.new(0,5,0,2)
l.BackgroundTransparency=1
l.Text=t..": "..dv
l.TextColor3=Color3.fromRGB(230,230,230)
l.TextSize=8
l.Font=Enum.Font.GothamMedium
l.TextXAlignment=Enum.TextXAlignment.Left
local tr=Instance.new("Frame",f)
tr.Size=UDim2.new(1,-8,0,4)
tr.Position=UDim2.new(0,4,0,19)
tr.BackgroundColor3=Color3.fromRGB(70,70,80)
tr.BorderSizePixel=0
Instance.new("UICorner",tr).CornerRadius=UDim.new(1,0)
local fl=Instance.new("Frame",tr)
fl.Size=UDim2.new((dv-mn)/(mx-mn),0,1,0)
fl.BackgroundColor3=Color3.fromRGB(70,130,200)
fl.BorderSizePixel=0
Instance.new("UICorner",fl).CornerRadius=UDim.new(1,0)
local kn=Instance.new("Frame",tr)
kn.Size=UDim2.new(0,9,0,9)
kn.Position=UDim2.new((dv-mn)/(mx-mn),-4.5,0.5,-4.5)
kn.BackgroundColor3=Color3.new(1,1,1)
kn.BorderSizePixel=0
Instance.new("UICorner",kn).CornerRadius=UDim.new(1,0)
local cl=Instance.new("TextButton",f)
cl.Size=UDim2.new(1,0,1,0)
cl.BackgroundTransparency=1
cl.Text=""
local dg=false
local function ud(i)
local ax=tr.AbsolutePosition.X
local sx=tr.AbsoluteSize.X
local x=math.clamp(i.Position.X-ax,0,sx)
local pc=x/sx
local v=math.floor(mn+(mx-mn)*pc)
fl.Size=UDim2.new(pc,0,1,0)
kn.Position=UDim2.new(pc,-4.5,0.5,-4.5)
l.Text=t..": "..v
if cbk then cbk(v)end end
cl.InputBegan:Connect(function(i)
if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
dg=true ud(i)end end)
cl.InputChanged:Connect(function(i)
if dg and(i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch)then
ud(i)end end)
UIS.InputEnded:Connect(function(i)
if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
dg=false end end)
end

local function mD(t,lst,dv,cbk)
local f=Instance.new("Frame",sc)
f.Size=UDim2.new(1,0,0,22)
f.BackgroundColor3=Color3.fromRGB(45,45,55)
f.BorderSizePixel=0
f.LayoutOrder=n()
Instance.new("UICorner",f).CornerRadius=UDim.new(0,4)
local btn=Instance.new("TextButton",f)
btn.Size=UDim2.new(1,0,1,0)
btn.BackgroundTransparency=1
btn.Text="  "..t..": "..dv.."  v"
btn.TextColor3=Color3.fromRGB(230,230,230)
btn.TextSize=9
btn.Font=Enum.Font.GothamMedium
btn.TextXAlignment=Enum.TextXAlignment.Left
local op,lf=false,nil
btn.MouseButton1Click:Connect(function()
if op and lf then lf:Destroy()lf=nil op=false return end
op=true
lf=Instance.new("ScrollingFrame",sg)
lf.Size=UDim2.new(0,140,0,110)
lf.Position=UDim2.new(0,60,0,200)
lf.BackgroundColor3=Color3.fromRGB(35,35,42)
lf.BorderSizePixel=0
lf.ZIndex=200
lf.ScrollBarThickness=3
lf.CanvasSize=UDim2.new(0,0,0,0)
lf.AutomaticCanvasSize=Enum.AutomaticSize.Y
Instance.new("UICorner",lf).CornerRadius=UDim.new(0,6)
local ly=Instance.new("UIListLayout",lf)
ly.Padding=UDim.new(0,2)
local nl=lst
if type(lst)=="function"then nl=lst()end
for _,w in ipairs(nl)do
local o=Instance.new("TextButton",lf)
o.Size=UDim2.new(1,-6,0,20)
o.BackgroundColor3=Color3.fromRGB(45,45,55)
o.Text="  "..w
o.TextColor3=Color3.fromRGB(230,230,230)
o.TextSize=9
o.Font=Enum.Font.GothamMedium
o.TextXAlignment=Enum.TextXAlignment.Left
o.BorderSizePixel=0
o.ZIndex=201
Instance.new("UICorner",o).CornerRadius=UDim.new(0,3)
o.MouseButton1Click:Connect(function()
dv=w
btn.Text="  "..t..": "..dv.."  v"
if cbk then cbk(w)end
if lf then lf:Destroy()lf=nil end
op=false end)
end end)
end

