-- TAKO HUB - FILE 1 (CORE)
local CG = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local VIM = game:GetService("VirtualInputManager")
local P = game.Players.LocalPlayer
local SG = game:GetService("StarterGui")

for _, obj in ipairs(CG:GetChildren()) do
    if obj:IsA("ScreenGui") and obj.Name:lower():find("tako") then
        pcall(function() obj:Destroy() end)
    end
end
task.wait(0.2)

_G.TakoLock = {
    targetTreeType = "Oak", autoChop = false, swingDelay = 0.7,
    choppedCount = 0, targetCount = 3, flyEnabled = false,
    flyHeight = 0, speedEnabled = false, speedValue = 60,
    noclipEnabled = false, alwaysDay = false
}
local lock = _G.TakoLock
_G.TakoBlacklist = {}

local function notify(title, text)
    pcall(function()
        SG:SetCore("SendNotification", {Title=title, Text=text, Duration=3})
    end)
end
_G.TakoNotify = notify

task.spawn(function()
    while true do
        task.wait(0.5)
        if lock.autoChop then
            local c = P.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h and h.Position.Y < -50 then
                local hum = c:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum.Health = 0 end) end
            end
        end
    end
end)

local function gTT(t)
    local c = t:FindFirstChild("TreeClass", true)
    if c and c:IsA("StringValue") then return tostring(c.Value) end
    local w = t:FindFirstChild("WoodType", true)
    if w then return tostring(w.Value) end
    local a = t:GetAttribute("TreeClass")
    if a then return tostring(a) end
    return t.Name
end
_G.TakoGTT = gTT

local function getAllTrees()
    local trees = {}
    for _, o in ipairs(workspace:GetChildren()) do
        if o.Name == "TreeRegion" then
            for _, t in ipairs(o:GetChildren()) do 
                if t:FindFirstChild("WoodSection", true) then 
                    if not _G.TakoBlacklist[t] then
                        local wsCount = 0
                        for _, p in ipairs(t:GetDescendants()) do
                            if p.Name == "WoodSection" then
                                wsCount = wsCount + 1
                                if wsCount >= 5 then break end
                            end
                        end
                        if wsCount >= 5 then table.insert(trees, t) end
                    end
                end
            end
        end
        if o:IsA("Folder") or o:IsA("Model") then
            local i = o:FindFirstChild("TreeRegion")
            if i then
                for _, t in ipairs(i:GetChildren()) do
                    if t:FindFirstChild("WoodSection", true) then 
                        if not _G.TakoBlacklist[t] then
                            local wsCount = 0
                            for _, p in ipairs(t:GetDescendants()) do
                                if p.Name == "WoodSection" then
                                    wsCount = wsCount + 1
                                    if wsCount >= 5 then break end
                                end
                            end
                            if wsCount >= 5 then table.insert(trees, t) end
                        end
                    end
                end
            end
        end
    end
    return trees
end
_G.TakoGetAllTrees = getAllTrees

local function getAvailableWoods()
    local types, list = {}, {}
    for _, t in ipairs(getAllTrees()) do
        local tp = gTT(t)
        if tp and tp ~= "" and not types[tp] then
            types[tp] = true
            table.insert(list, tp)
        end
    end
    table.sort(list)
    return list
end
_G.TakoGetAvailableWoods = getAvailableWoods

local function findWoodSection(tree)
    for _, p in ipairs(tree:GetDescendants()) do
        if p.Name == "WoodSection" or p.Name == "Wood" or p.Name == "Log" then return p end
    end
    return nil
end
_G.TakoFindWoodSection = findWoodSection

local function findAllSections(tree)
    local list = {}
    for _, p in ipairs(tree:GetDescendants()) do
        if p.Name == "WoodSection" or p.Name == "Wood" or p.Name == "Log" then table.insert(list, p) end
    end
    return list
end
_G.TakoFindAllSections = findAllSections

local function findNearestWS(tree)
    local c = P.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    if not h then return nil end
    local sections = findAllSections(tree)
    if #sections == 0 then 
        if tree.PrimaryPart then _G.TakoLowestWS = tree.PrimaryPart return tree.PrimaryPart end
        return nil 
    end
    local lowest = sections[1]
    for i = 2, #sections do
        if sections[i].Position.Y < lowest.Position.Y then lowest = sections[i] end
    end
    _G.TakoLowestWS = lowest
    return lowest
end
_G.TakoFindNearestWS = findNearestWS

local function findAxe()
    local c = P.Character
    if not c then return nil end
    for _, tool in ipairs(c:GetChildren()) do
        if tool:IsA("Tool") and (tool:FindFirstChild("CuttingTool") or tool:FindFirstChild("AxeClient", true)) then return tool end
    end
    local bp = P:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool:FindFirstChild("CuttingTool") or tool:FindFirstChild("AxeClient", true)) then return tool end
        end
    end
    return nil
end
_G.TakoFindAxe = findAxe

local function tpInsideTree(tree)
    local c = P.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not h or not hum then return false end
    local targetWS = findNearestWS(tree)
    if not targetWS then return false end
    _G.TakoTargetWS = targetWS
    _G.TakoTargetTree = tree
    _G.TakoLowestWS = targetWS
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            pcall(function()
                p.CanCollide = false
                p.CanQuery = false
                p.CanTouch = false
            end)
        end
    end
    local treePos = targetWS.Position
    local myPos = h.Position
    local dir = myPos - treePos
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.5 then dir = Vector3.new(1, 0, 0) end
    dir = dir.Unit
    local sidePos = treePos + dir * 6
    local targetY = treePos.Y + 3
    sidePos = Vector3.new(sidePos.X, targetY, sidePos.Z)
    local ignoreList = {c, tree}
    local ray = Ray.new(Vector3.new(sidePos.X, sidePos.Y + 30, sidePos.Z), Vector3.new(0, -60, 0))
    local hp, hpos = workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
    if hp and hpos then
        sidePos = Vector3.new(sidePos.X, hpos.Y + 3, sidePos.Z)
    else
        local r2 = Ray.new(Vector3.new(sidePos.X, treePos.Y + 100, sidePos.Z), Vector3.new(0, -200, 0))
        local hp2, hpos2 = workspace:FindPartOnRayWithIgnoreList(r2, ignoreList)
        if hp2 and hpos2 then sidePos = Vector3.new(sidePos.X, hpos2.Y + 3, sidePos.Z)
        else sidePos = Vector3.new(sidePos.X, treePos.Y + 3, sidePos.Z) end
    end
    h.CFrame = CFrame.lookAt(sidePos, Vector3.new(treePos.X, sidePos.Y, treePos.Z))
    h.Velocity = Vector3.zero
    hum.AutoRotate = false
    return true
end
_G.TakoTPInsideTree = tpInsideTree

local savedCamType = nil

local function aimAtTree(targetWS)
    local c = P.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    if not h then return false end
    local cam = workspace.CurrentCamera
    if cam then
        if not savedCamType then savedCamType = cam.CameraType end
        pcall(function()
            cam.CameraType = Enum.CameraType.Scriptable
            cam.CFrame = CFrame.lookAt(h.Position + Vector3.new(0, 4, 0), targetWS.Position)
        end)
    end
    local mouse = P:GetMouse()
    if mouse then
        pcall(function()
            mouse.Target = targetWS
            mouse.Hit = CFrame.new(targetWS.Position)
        end)
    end
    return true
end
_G.TakoAimAtTree = aimAtTree

local function restoreCamera()
    local cam = workspace.CurrentCamera
    if cam then
        pcall(function()
            cam.CameraType = savedCamType or Enum.CameraType.Custom
            local c = P.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if hum then cam.CameraSubject = hum end
        end)
    end
end
_G.TakoRestoreCamera = restoreCamera

notify("TAKO HUB", "File 1 Loaded")
print("TAKO HUB FILE 1 LOADED")

