local CG=game:GetService("CoreGui")local TS=game:GetService("TweenService")local UIS=game:GetService("UserInputService")local RS=game:GetService("RunService")local P=game.Players.LocalPlayer
if CG:FindFirstChild("MyLT2UI")then CG.MyLT2UI:Destroy()end
local fO,cO,sO,nO,dO=false,false,false,false,false
local sW="Generic"local fH=0 local sV=60
local targetTree=1
local choppedCount=0
local fC,fB,fA,fY,chC,dC
local ord=0 local function n()ord=ord+1 return ord end
local REGIONS={"Region_LittleMeadow","Region_Plains","Region_Main","Region_SandIslands","Region_Snow","Region_SnowPeak","Region_Swamp","Region_Tropics","Region_Volcano","Region_MountainSide","Region_MazeCave","Region_Underbridge","Region_WaterCave"}

RS.RenderStepped:Connect(function()
local c=P.Character if not c then return end
local m=c:FindFirstChildOfClass("Humanoid")if not m then return end
if nO then for _,p in ipairs(c:GetDescendants())do if p:IsA("BasePart")then pcall(function()p.CanCollide=false p.CanQuery=false p.CanTouch=false end)end end end
if sO and not fO then pcall(function() m.WalkSpeed=sV end)end
end)

local function sDay()
dO=true local l=game:GetService("Lighting")
l.ClockTime=14 l.Brightness=2 l.GlobalShadows=false
dC=RS.Heartbeat:Connect(function()if dO then l.ClockTime=14 l.Brightness=2 end end)
end
local function stDay()
dO=false if dC then dC:Disconnect()dC=nil end
game:GetService("Lighting").Brightness=1
end

local function gPL()
local l={}
for _,pl in ipairs(game.Players:GetPlayers())do
if pl~=P then local ch=pl.Character
if ch and ch:FindFirstChild("HumanoidRootPart")then table.insert(l,pl.Name)end end end
return l
end

local function tpP(pN)
local t=game.Players:FindFirstChild(pN)if not t then return false end
local tc=t.Character if not tc then return false end
local th=tc:FindFirstChild("HumanoidRootPart")if not th then return false end
local mc=P.Character if not mc then return false end
local mh=mc:FindFirstChild("HumanoidRootPart")if not mh then return false end
local tp=th.Position local tl=th.CFrame.LookVector
mh.CFrame=CFrame.new(tp-tl*3,tp)
print("[TAKO] TP ke pemain:",pN)return true
end

local function gTT(t)
local c=t:FindFirstChild("TreeClass")
if c then return tostring(c.Value) end
local w=t:FindFirstChild("WoodType")
if w then return tostring(w.Value) end
local a=t:GetAttribute("TreeClass")
if a then return tostring(a) end
return t.Name
end

local function getAllTrees()
local trees={}
for _,obj in ipairs(workspace:GetChildren())do
if obj.Name=="TreeRegion"then
for _,tree in ipairs(obj:GetChildren())do table.insert(trees,tree)end
end
if obj:IsA("Folder") or obj:IsA("Model")then
local innerTR=obj:FindFirstChild("TreeRegion")
if innerTR then
for _,tree in ipairs(innerTR:GetChildren())do table.insert(trees,tree)end
end
end
end
return trees
end

local function getAvailableWoods()
local trees=getAllTrees()
local types={}
local list={}
for _,t in ipairs(trees)do
local tp=gTT(t)
if not types[tp]then
types[tp]=true
table.insert(list,tp)
end
end
table.sort(list)
return list
end

local function tpToRegion(regionName)
local region=workspace:FindFirstChild(regionName)
if not region then print("[TAKO] Region gak ada") return false end
local char=P.Character
local hrp=char and char:FindFirstChild("HumanoidRootPart")
if not hrp then return false end
local targetPos=nil
if region:IsA("Folder") or region:IsA("Model")then
for _,part in ipairs(region:GetDescendants())do
if part:IsA("BasePart")then
targetPos=part.Position+Vector3.new(0,5,0)
break
end
end
end
if targetPos then
hrp.CFrame=CFrame.new(targetPos)
print("[TAKO] TP ke region:",regionName)
return true
end
return false
end

local function fT()
local c=P.Character
local h=c and c:FindFirstChild("HumanoidRootPart")
if not h then print("[TAKO] Karakter gak ada") return end
local allTrees=getAllTrees()
if #allTrees==0 then print("[TAKO] Pohon belum spawn") return end
local b=nil
local mD=math.huge
local sw=sW:lower()
for _,t in ipairs(allTrees)do
local tp=gTT(t)
local tl=tp:lower()
local mt=(tl==sw) or (tl:find(sw,1,true)~=nil)
if mt then
for _,p in ipairs(t:GetDescendants())do
if p.Name=="WoodSection"then
local d=(p.Position-h.Position).Magnitude
if d<mD then mD=d b={pos=p.Position,type=tp}end
break
end
end
end
end
if b then
print("[TAKO] Ketemu:",sW,"| Objek:",b.type)
local wp=b.pos
local dir=Vector3.new(wp.X-h.Position.X,0,wp.Z-h.Position.Z)
if dir.Magnitude<0.1 then dir=Vector3.new(1,0,0)end
dir=dir.Unit
local fp=wp-dir*2.5+Vector3.new(0,1,0)
h.CFrame=CFrame.lookAt(fp, Vector3.new(wp.X, fp.Y, wp.Z))
else
print("[TAKO] GAK ADA pohon:",sW)
end
end

local function tpT()
fT()
end

local function sF()
if fO then return end
fO=true
local c=P.Character
local h=c and c:FindFirstChild("HumanoidRootPart")
local m=c and c:FindFirstChildOfClass("Humanoid")
if not h or not m then fO=false return end
m.AutoRotate=false fY=h.Position.Y
local at=Instance.new("Attachment",h)at.Name="FlyAtt"
fA=Instance.new("AlignOrientation",h)fA.Attachment0=at
fA.Mode=Enum.OrientationAlignmentMode.OneAttachment
fA.MaxTorque=9e9 fA.Responsiveness=50 fA.CFrame=CFrame.new(h.Position)
fB=Instance.new("BodyVelocity",h)fB.MaxForce=Vector3.new(9e9,9e9,9e9)
fB.Velocity=Vector3.zero fB.P=50000
fC=RS.RenderStepped:Connect(function(dt)
if not fO then return end
local cc=P.Character if not cc then return end
local r=cc:FindFirstChild("HumanoidRootPart")local hh=cc:FindFirstChildOfClass("Humanoid")
if not r or not hh or not fB then return end
local md=hh.MoveDirection local tv=Vector3.zero
if md.Magnitude>0 then local f=Vector3.new(md.X,0,md.Z)
if f.Magnitude>0 then tv=f.Unit*60 end end
local v=fB.Velocity
local sx=v.X+(tv.X-v.X)*math.min(dt*12,1)
local sz=v.Z+(tv.Z-v.Z)*math.min(dt*12,1)
local ty=fY+fH local df=ty-r.Position.Y local vy=0
if math.abs(df)>0.3 then vy=math.clamp(df*10,-300,300)end
fB.Velocity=Vector3.new(sx,vy,sz)
if fA then fA.CFrame=CFrame.new(r.Position)end
end)
end
local function stF()
fO=false if fC then fC:Disconnect()fC=nil end
local c=P.Character if c then local m=c:FindFirstChildOfClass("Humanoid")
if m then m.AutoRotate=true end end
if fB then fB:Destroy()fB=nil end
if fA then fA:Destroy()fA=nil end
end

local function sCh()
cO=true
choppedCount=0
chC=task.spawn(function()
    local currentTree=nil
    local cuttingDone=false
    local hasTP=false
    
    while cO do
        local c=P.Character
        if c then
            local h=c:FindFirstChild("HumanoidRootPart")
            local tl=c:FindFirstChildOfClass("Tool")
            
            if not tl then
                local bp=P:FindFirstChild("Backpack")
                if bp then
                    for _,t in ipairs(bp:GetChildren())do
                        if t:IsA("Tool")then
                            c.Humanoid:EquipTool(t)
                            task.wait(0.3)
                            break
                        end
                    end
                end
            elseif h then
                if cuttingDone then
                    print("[TAKO] Jeda 3 detik...")
                    task.wait(3)
                    cuttingDone=false
                    currentTree=nil
                    hasTP=false
                    if targetTree>0 and choppedCount>=targetTree then
                        print("[TAKO] Batch selesai — lanjut batch baru")
                        choppedCount=0
                    end
                end
                
                if not currentTree then
                    local nr,mD=nil,25
                    local nrTree=nil
                    local allTrees=getAllTrees()
                    local sw=sW:lower()
                    for _,t in ipairs(allTrees)do
                        local tp=gTT(t)
                        local tl2=tp:lower()
                        local mt=(tl2==sw) or (tl2:find(sw,1,true)~=nil)
                        if mt then
                            for _,p in ipairs(t:GetDescendants())do
                                if p.Name=="WoodSection"then
                                    local d=(p.Position-h.Position).Magnitude
                                    if d<mD then
                                        mD=d
                                        nr=p
                                        nrTree=t
                                    end
                                    break
                                end
                            end
                        end
                    end
                    
                    if nr and nrTree then
                        currentTree=nrTree
                        local wp=nr.Position
                        local dir=Vector3.new(wp.X-h.Position.X,0,wp.Z-h.Position.Z)
                        if dir.Magnitude<0.1 then dir=Vector3.new(1,0,0)end
                        dir=dir.Unit
                        local fp=wp-dir*2.5+Vector3.new(0,1,0)
                        h.CFrame=CFrame.lookAt(fp, Vector3.new(wp.X, fp.Y, wp.Z))
                        print("[TAKO] TP ke pohon ke-"..(choppedCount+1).."/"..(targetTree>0 and targetTree or "∞"))
                        task.wait(0.1)
                        hasTP=true
                    else
                        task.wait(1)
                    end
                else
                    local ws=nil
                    for _,p in ipairs(currentTree:GetDescendants())do
                        if p.Name=="WoodSection"then
                            ws=p break
                        end
                    end
                    
                    if ws then
                        if hasTP then
                            local wp=ws.Position
                            local fp=h.Position
                            h.CFrame=CFrame.lookAt(fp, Vector3.new(wp.X, fp.Y, wp.Z))
                            pcall(function() tl:Activate() end)
                        end
                    else
                        choppedCount=choppedCount+1
                        print("[TAKO] Pohon tumbang! ("..choppedCount.."/"..(targetTree>0 and targetTree or "∞")..")")
                        cuttingDone=true
                    end
                end
            end
        end
        task.wait(0.4)
    end
end)
end

