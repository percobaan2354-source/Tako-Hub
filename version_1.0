local findAllSections = _G.TakoFindAllSections
local findNearestWS = _G.TakoFindNearestWS
local findAxe = _G.TakoFindAxe
local tpInsideTree = _G.TakoTPInsideTree
local aimAtTree = _G.TakoAimAtTree
local restoreCamera = _G.TakoRestoreCamera

-- AUTO CHOP LOOP
local function startAutoChop()
    task.spawn(function()
        while lock.autoChop do
            local c = P.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if not c or not h or not hum then task.wait(0.5) continue end
            local axe = findAxe()
            if not axe then task.wait(2) continue end
            if axe.Parent ~= c then pcall(function() hum:EquipTool(axe) end) task.wait(0.3) end
            local sw = lock.targetTreeType:lower()
            local nearest, mD = nil, math.huge
            for _, t in ipairs(getAllTrees()) do
                local tp = gTT(t):lower()
                if tp == sw or tp:find(sw, 1, true) then
                    local section = findWoodSection(t)
                    if section then
                        local d = (section.Position - h.Position).Magnitude
                        if d < mD then mD = d nearest = t end
                    end
                end
            end
            if nearest then
                if not nearest.Parent then task.wait(0.5) continue end
                if _G.TakoLastTree and _G.TakoLastTree == nearest then task.wait(1) continue end
                local sections = findAllSections(nearest)
                if #sections > 0 then
                    if not _G.TakoTargetWS or not _G.TakoTargetWS.Parent or mD > 8 then
                        tpInsideTree(nearest)
                        task.wait(0.5)
                    else
                        local targetWS = _G.TakoLowestWS
                        if not targetWS or not targetWS.Parent then targetWS = findNearestWS(nearest) end
                        _G.TakoTargetWS = targetWS
                        local treePos = targetWS.Position
                        local myPos = h.Position
                        local dir = myPos - treePos
                        dir = Vector3.new(dir.X, 0, dir.Z)
                        if dir.Magnitude < 0.5 then dir = Vector3.new(1, 0, 0) end
                        dir = dir.Unit
                        local sidePos = treePos + dir * 6
                        local targetY = treePos.Y + 3
                        if myPos.Y > targetY and myPos.Y < targetY + 15 then targetY = myPos.Y end
                        sidePos = Vector3.new(sidePos.X, targetY, sidePos.Z)
                        local dc = (Vector3.new(sidePos.X, 0, sidePos.Z) - Vector3.new(myPos.X, 0, myPos.Z)).Magnitude
                        if dc > 1.5 then
                            h.CFrame = CFrame.lookAt(sidePos, Vector3.new(treePos.X, sidePos.Y, treePos.Z))
                            h.Velocity = Vector3.zero
                        end
                        aimAtTree(targetWS)
                        task.wait(0.05)
                        local cam2 = workspace.CurrentCamera
                        local sp, onScreen = cam2:WorldToViewportPoint(targetWS.Position)
                        if onScreen then
                            pcall(function()
                                VIM:SendTouchEvent(Enum.UserInputType.Touch, sp, true, game)
                                task.wait(0.03)
                                VIM:SendTouchEvent(Enum.UserInputType.Touch, sp, false, game)
                            end)
                            pcall(function()
                                VIM:SendMouseButtonEvent(sp.X, sp.Y, 0, true, game, 1)
                                task.wait(0.03)
                                VIM:SendMouseButtonEvent(sp.X, sp.Y, 0, false, game, 1)
                            end)
                        end
                        pcall(function() axe:Activate() end)
                        task.wait(lock.swingDelay)
                    end
                else
                    _G.TakoBlacklist[nearest] = true
                    _G.TakoLastTree = nearest
                    _G.TakoLowestWS = nil
                    lock.choppedCount = lock.choppedCount + 1
                    local tc = lock.targetCount or 3
                    if tc < 1 then tc = 1 end
                    if tc > 3 then tc = 3 end
                    notify("TAKO", "Pohon tumbang! ("..lock.choppedCount.."/"..tc..")")
                    task.wait(3)
                    local wc = 0
                    while nearest.Parent and wc < 20 do task.wait(0.5) wc = wc + 1 end
                    if not nearest.Parent then _G.TakoBlacklist[nearest] = nil end
                    _G.TakoTargetWS = nil
                    _G.TakoTargetTree = nil
                    if lock.choppedCount >= tc then
                        lock.choppedCount = 0
                        _G.TakoBlacklist = {}
                        notify("TAKO", "Siklus baru! Target: "..tc)
                    end
                end
            else
                task.wait(2)
                if next(_G.TakoBlacklist) then _G.TakoBlacklist = {} end
            end
            task.wait(0.05)
        end
    end)
end

