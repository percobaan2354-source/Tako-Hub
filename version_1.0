local RS = game:GetService("RunService")
local P = game.Players.LocalPlayer
local notify = _G.TakoNotify
local lock = _G.TakoLock
local makeSection = _G.TakoMakeSection
local makeToggle = _G.TakoMakeToggle
local makeSlider = _G.TakoMakeSlider
local makeBtn = _G.TakoMakeBtn
local makeDropdown = _G.TakoMakeDropdown

-- FLY
local flyConn = nil
local alignOrient = nil
local bodyVel = nil
local flyAttach = nil

local function startFly()
    if lock.flyEnabled then return end
    lock.flyEnabled = true
    local c = P.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not h or not hum then lock.flyEnabled = false return end
    hum.AutoRotate = false
    flyAttach = Instance.new("Attachment", h)
    alignOrient = Instance.new("AlignOrientation", h)
    alignOrient.Attachment0 = flyAttach
    alignOrient.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrient.MaxTorque = 9e9
    alignOrient.Responsiveness = 50
    bodyVel = Instance.new("BodyVelocity", h)
    bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVel.Velocity = Vector3.zero
    bodyVel.P = 50000
    flyConn = RS.RenderStepped:Connect(function(dt)
        if not lock.flyEnabled then return end
        local c2 = P.Character
        local h2 = c2 and c2:FindFirstChild("HumanoidRootPart")
        local hum2 = c2 and c2:FindFirstChildOfClass("Humanoid")
        if not h2 or not hum2 or not bodyVel then return end
        local md = hum2.MoveDirection
        local tv = Vector3.zero
        if md.Magnitude > 0 then
            local f = Vector3.new(md.X, 0, md.Z)
            if f.Magnitude > 0 then tv = f.Unit * 60 end
        end
        local v = bodyVel.Velocity
        local sx = v.X + (tv.X - v.X) * math.min(dt * 12, 1)
        local sz = v.Z + (tv.Z - v.Z) * math.min(dt * 12, 1)
        local ty = h2.Position.Y + lock.flyHeight
        local df = ty - h2.Position.Y
        local vy = 0
        if math.abs(df) > 0.3 then vy = math.clamp(df * 10, -300, 300) end
        bodyVel.Velocity = Vector3.new(sx, vy, sz)
        if alignOrient then alignOrient.CFrame = CFrame.new(h2.Position) end
    end)
end

local function stopFly()
    lock.flyEnabled = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    local c = P.Character
    if c then
        local hum = c:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
    end
    if bodyVel then bodyVel:Destroy() bodyVel = nil end
    if alignOrient then alignOrient:Destroy() alignOrient = nil end
    if flyAttach then flyAttach:Destroy() flyAttach = nil end
end

RS.RenderStepped:Connect(function()
    local c = P.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if lock.speedEnabled then pcall(function() hum.WalkSpeed = lock.speedValue end) end
    if lock.noclipEnabled then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then pcall(function() p.CanCollide = false end) end
        end
    end
end)

local dayConn = nil
local function startDay()
    if lock.alwaysDay then return end
    lock.alwaysDay = true
    local l = game:GetService("Lighting")
    l.ClockTime = 14
    l.Brightness = 2
    l.GlobalShadows = false
    dayConn = RS.Heartbeat:Connect(function()
        if lock.alwaysDay then l.ClockTime = 14 l.Brightness = 2 end
    end)
end
local function stopDay()
    lock.alwaysDay = false
    if dayConn then dayConn:Disconnect() dayConn = nil end
    game:GetService("Lighting").Brightness = 1
end

-- TP
local function tpTo(pos, name)
    local c = P.Character
    if not c then notify("TP", "Karakter gak ada") return end
    local h = c:FindFirstChild("HumanoidRootPart")
    if not h then notify("TP", "HRP gak ada") return end
    if c.PivotTo then c:PivotTo(CFrame.new(pos)) else h.CFrame = CFrame.new(pos) end
    h.Velocity = Vector3.zero
    notify("TP "..name, "Berhasil")
end

local function getDropoffPos()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Wood Crate" then return obj.Position + Vector3.new(0, 5, 0) end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "SELLWOOD" or obj.Name == "WOODDROPOFF" then return obj.Position + Vector3.new(0, 5, 0) end
    end
    return nil
end

local function getSpawnPos()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then return obj.Position + Vector3.new(0, 5, 0) end
    end
    return nil
end

local REGIONS = {
    "Region_LittleMeadow","Region_Plains","Region_Main","Region_SandIslands",
    "Region_Snow","Region_SnowPeak","Region_Swamp","Region_Tropics",
    "Region_Volcano","Region_MountainSide","Region_MazeCave","Region_Underbridge",
    "Region_WaterCave"
}

local function tpToRegion(rn)
    local region = workspace:FindFirstChild(rn)
    if not region then notify("REGION", "Gak ada") return end
    local c = P.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    if not h then return end
    local tp = nil
    if region:IsA("Folder") or region:IsA("Model") then
        for _, part in ipairs(region:GetDescendants()) do
            if part:IsA("BasePart") then tp = part.Position + Vector3.new(0, 5, 0) break end
        end
    end
    if tp then tpTo(tp, rn) end
end

local function getPlayerList()
    local list = {}
    for _, pl in ipairs(game.Players:GetPlayers()) do
        if pl ~= P then
            local ch = pl.Character
            if ch and ch:FindFirstChild("HumanoidRootPart") then table.insert(list, pl.Name) end
        end
    end
    return list
end

local function tpToPlayer(pn)
    local t = game.Players:FindFirstChild(pn)
    if not t then notify("TP", "Player gak ada") return end
    local tc = t.Character
    if not tc then notify("TP", "Char gak ada") return end
    local th = tc:FindFirstChild("HumanoidRootPart")
    if not th then notify("TP", "HRP gak ada") return end
    tpTo(th.Position - th.CFrame.LookVector * 3, pn)
end

