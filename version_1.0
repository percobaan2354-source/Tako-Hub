    b.Size = UDim2.new(1, 0, 1, 0)
    b.BackgroundTransparency = 1
    b.Text = "  "..text..": "..default
    b.TextColor3 = Color3.fromRGB(230, 230, 230)
    b.TextSize = 9
    b.Font = Enum.Font.GothamBold
    b.TextXAlignment = Enum.TextXAlignment.Left
    local op, lf = false, nil
    b.MouseButton1Click:Connect(function()
        if op and lf then lf:Destroy() lf = nil op = false return end
        op = true
        lf = Instance.new("ScrollingFrame", sg)
        lf.Size = UDim2.new(0, 160, 0, 200)
        lf.Position = UDim2.new(0, 60, 0, 180)
        lf.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
        lf.BorderSizePixel = 0
        lf.ZIndex = 200
        lf.ScrollBarThickness = 3
        lf.CanvasSize = UDim2.new(0, 0, 0, 0)
        lf.AutomaticCanvasSize = Enum.AutomaticSize.Y
        Instance.new("UICorner", lf).CornerRadius = UDim.new(0, 6)
        local ly = Instance.new("UIListLayout", lf)
        ly.Padding = UDim.new(0, 2)
        for _, w in ipairs(getList()) do
            local o = Instance.new("TextButton", lf)
            o.Size = UDim2.new(1, -4, 0, 22)
            o.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            o.Text = "  "..w
            o.TextColor3 = Color3.fromRGB(230, 230, 230)
            o.TextSize = 9
            o.Font = Enum.Font.GothamBold
            o.TextXAlignment = Enum.TextXAlignment.Left
            o.BorderSizePixel = 0
            o.ZIndex = 201
            Instance.new("UICorner", o).CornerRadius = UDim.new(0, 3)
            o.MouseButton1Click:Connect(function()
                b.Text = "  "..text..": "..w
                if cbk then cbk(w) end
                if lf then lf:Destroy() lf = nil end
                op = false
            end)
        end
    end)
end

-- MENU AUTO CHOP
_G.TakoMakeSection("AUTO CHOP")
_G.TakoMakeDropdown("Jenis Kayu", getAvailableWoods, lock.targetTreeType, function(w)
    lock.targetTreeType = w
    _G.TakoTargetWS = nil
    _G.TakoLastTree = nil
    _G.TakoLowestWS = nil
    _G.TakoBlacklist = {}
end)
_G.TakoMakeSlider("Target Pohon", 1, 3, lock.targetCount, function(v) lock.targetCount = v end)
_G.TakoMakeSlider("Delay Swing", 0.3, 2, lock.swingDelay, function(v) lock.swingDelay = v end)
_G.TakoMakeBtn("TP KE POHON", Color3.fromRGB(45, 90, 60), function()
    local sw = lock.targetTreeType:lower()
    local nearest, mD = nil, math.huge
    for _, t in ipairs(getAllTrees()) do
        local tp = gTT(t):lower()
        if tp == sw or tp:find(sw, 1, true) then
            local section = findWoodSection(t)
            if section then
                local c = P.Character
                local h = c and c:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (section.Position - h.Position).Magnitude
                    if d < mD then mD = d nearest = t end
                end
            end
        end
    end
    if nearest then
        _G.TakoTargetWS = nil
        _G.TakoLastTree = nil
        _G.TakoLowestWS = nil
        local ok = tpInsideTree(nearest)
        notify("TAKO", ok and ("TP: "..gTT(nearest)) or "TP gagal")
    else
        notify("TAKO", "Gak nemu: "..lock.targetTreeType)
    end
end)
_G.TakoMakeBtn("TES AIM + TOUCH", Color3.fromRGB(90, 60, 45), function()
    local sw = lock.targetTreeType:lower()
    for _, t in ipairs(getAllTrees()) do
        local tp = gTT(t):lower()
        if tp == sw or tp:find(sw, 1, true) then
            if not _G.TakoTargetWS or not _G.TakoTargetWS.Parent then _G.TakoTargetWS = findNearestWS(t) end
            local tws = _G.TakoTargetWS
            if tws then
                aimAtTree(tws)
                task.wait(0.3)
                local cam2 = workspace.CurrentCamera
                local sp, onScreen = cam2:WorldToViewportPoint(tws.Position)
                if onScreen then
                    pcall(function()
                        VIM:SendTouchEvent(Enum.UserInputType.Touch, sp, true, game)
                        task.wait(0.03)
                        VIM:SendTouchEvent(Enum.UserInputType.Touch, sp, false, game)
                    end)
                end
                notify("TAKO", "Aim + Touch!")
                task.wait(1)
                restoreCamera()
            end
            return
        end
    end
end)
_G.TakoMakeToggle("Auto Chop", function(s)
    lock.autoChop = s
    if s then
        _G.TakoLastTree = nil
        _G.TakoLowestWS = nil
        lock.choppedCount = 0
        startAutoChop()
        notify("TAKO", "Auto Chop ON")
    else
        restoreCamera()
        notify("TAKO", "Auto Chop OFF")
    end
end)
_G.TakoMakeBtn("CEK KAPAK", Color3.fromRGB(60, 60, 90), function()
    local axe = findAxe()
    if axe then
        local tn = axe:FindFirstChild("ToolName")
        notify("TAKO", "Kapak: "..(tn and tostring(tn.Value) or axe.Name))
    else
        notify("TAKO", "Gak ada kapak")
    end
end)

